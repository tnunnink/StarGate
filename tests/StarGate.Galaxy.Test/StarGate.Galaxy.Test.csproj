<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <Platforms>x86</Platforms>
        <PlatformTarget>x86</PlatformTarget>
        <LangVersion>latestmajor</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
        <Prefer32bit>true</Prefer32bit>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="ArchestrA.GRAccess">
            <HintPath>$(SystemDrive)\Program Files (x86)\Common Files\ArchestrA\ArchestrA.GRAccess.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ArchestrA.Visualization.GraphicAccess">
            <HintPath>$(SystemDrive)\Program Files (x86)\ArchestrA\Framework\Bin\ArchestrA.Visualization.GraphicAccess.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="System.Configuration"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\StarGate.Core\StarGate.Core.csproj"/>
        <ProjectReference Include="..\..\src\StarGate.Galaxy\StarGate.Galaxy.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="7.2.2"/>
        <PackageReference Include="NUnit" Version="5.0.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="Verify.NUnit" Version="31.28.0"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Resources\"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Resources\TestObjects.aaPKG">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="GalaxyRepositoryTests.GetObjects_KnownInstance_ShouldHaveExpectedFormat.verified.txt">
          <DependentUpon>GalaxyRepositoryTests.cs</DependentUpon>
        </None>
        <None Update="GalaxyRepositoryTests.GetObjects_KnownTemplate_ShouldBeVerified.verified.txt">
          <DependentUpon>GalaxyRepositoryTests.cs</DependentUpon>
        </None>
    </ItemGroup>

</Project>