<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <Platforms>x86</Platforms>
        <PlatformTarget>x86</PlatformTarget>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="7.2.2"/>
        <PackageReference Include="MSTest" Version="4.5.2"/>
        <PackageReference Include="Verify.MSTest" Version="31.28.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\StarGate.Core\StarGate.Core.csproj"/>
        <ProjectReference Include="..\..\src\StarGate.Galaxy\StarGate.Galaxy.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="ArchestrA.GRAccess">
            <HintPath>$(SystemDrive)\Program Files (x86)\Common Files\ArchestrA\ArchestrA.GRAccess.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ArchestrA.Visualization.GraphicAccess">
            <HintPath>$(SystemDrive)\Program Files (x86)\ArchestrA\Framework\Bin\ArchestrA.Visualization.GraphicAccess.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ArchestrA.Configuration">
            <HintPath>$(SystemDrive)\Program Files (x86)\Wonderware\InTouch\ArchestrA.Configuration.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ArchestrA.Core">
            <HintPath>$(SystemDrive)\Program Files (x86)\Wonderware\InTouch\ArchestrA.Core.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="Resources\TestObjects.aaPKG">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
